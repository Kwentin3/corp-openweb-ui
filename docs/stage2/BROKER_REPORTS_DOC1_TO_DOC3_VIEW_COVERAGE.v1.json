    {"doc1_field_path":"/relations/*/evidence_anchor_ids","disposition":"RENDERED_AS_SAFE_POINTER","exact_owner":"RELATION evidence"},
    {"doc1_field_path":"/quality","disposition":"RENDERED","exact_owner":"QUALITY plus issue and loss ledgers"},
    {"doc1_field_path":"/quality/**","disposition":"RENDERED","exact_owner":"QUALITY plus issue and loss ledgers"},
    {"doc1_field_path":"/quality/information_class","disposition":"OMITTED_REDUNDANT_WITH_EXACT_OWNER","exact_owner":"QUALITY record contract"},
    {"doc1_field_path":"/quality/issue_ledger/*/anchor_ids","disposition":"RENDERED_AS_SAFE_POINTER","exact_owner":"ISSUE sources"},
    {"doc1_field_path":"/quality/loss_ledger/*/anchor_ids","disposition":"RENDERED_AS_SAFE_POINTER","exact_owner":"LOSS sources"},
    {"doc1_field_path":"/integrity_sha256","disposition":"OMITTED_CONTROL_FIELD","exact_owner":"private render receipt input_managed_document_sha256"}
