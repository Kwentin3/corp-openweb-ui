    {"doc1_field_path":"/blocks/*/content/*/evidence_anchor_ids","disposition":"RENDERED_AS_SAFE_POINTER","exact_owner":"typed block SOURCE projection"},
    {"doc1_field_path":"/relations","disposition":"RENDERED","exact_owner":"RELATIONS section"},
