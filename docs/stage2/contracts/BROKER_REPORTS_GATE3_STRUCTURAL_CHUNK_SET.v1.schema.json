{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kwentin3.invalid/schemas/broker-reports/gate3-structural-chunk-set-v1.schema.json",
  "title": "Broker Reports Gate 3 Structural Chunk Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_binding",
    "budget",
    "chunks",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "const": "broker_reports_gate3_structural_chunk_set_v1"
    },
    "canonical_binding": {
      "$ref": "#/$defs/canonicalBinding"
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/chunk"
      }
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    }
  },
  "$defs": {
    "canonicalBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "canonical_version_id"],
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "canonical_version_id": {"type": "string", "minLength": 1}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measure", "max_chunk_chars"],
      "properties": {
        "measure": {"const": "model_view_chars"},
        "max_chunk_chars": {"type": "integer", "minimum": 1}
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunk_id",
        "ordinal",
        "canonical_binding",
        "structural_kind",
        "structural_scope",
        "context_policy",
        "model_view",
        "target_mappings",
        "metrics"
      ],
      "properties": {
        "chunk_id": {
          "type": "string",
          "pattern": "^g3chunk_[0-9a-f]{24}$"
        },
        "ordinal": {"type": "integer", "minimum": 1},
        "canonical_binding": {"$ref": "#/$defs/canonicalBinding"},
        "structural_kind": {
          "enum": [
            "whole_document",
            "structural_blocks",
            "whole_table",
            "table_rows"
          ]
        },
        "structural_scope": {"$ref": "#/$defs/structuralScope"},
        "context_policy": {"$ref": "#/$defs/contextPolicy"},
        "model_view": {"$ref": "#/$defs/modelView"},
        "target_mappings": {
          "type": "array",
          "items": {"$ref": "#/$defs/targetMapping"}
        },
        "metrics": {"$ref": "#/$defs/metrics"}
      }
    },
    "structuralScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container_refs",
        "node_refs",
        "row_start",
        "row_end"
      ],
      "properties": {
        "container_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "node_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "row_start": {
          "anyOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "row_end": {
          "anyOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        }
      }
    },
    "contextPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_only_target_aliases",
        "data_row_overlap",
        "ancestor_headings",
        "repeated_table_header",
        "repeated_table_notes"
      ],
      "properties": {
        "context_only_target_aliases": {"const": 0},
        "data_row_overlap": {"const": 0},
        "ancestor_headings": {"type": "integer", "minimum": 0},
        "repeated_table_header": {"type": "boolean"},
        "repeated_table_notes": {"type": "boolean"}
      }
    },
    "modelView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "content"],
      "properties": {
        "media_type": {"const": "text/markdown"},
        "content": {"type": "string", "minLength": 1}
      }
    },
    "targetMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_alias", "canonical_target"],
      "properties": {
        "target_alias": {
          "type": "string",
          "pattern": "^t[0-9]{3,}$"
        },
        "canonical_target": {
          "$ref": "https://kwentin3.invalid/schemas/broker-reports/gate3-target-v1.schema.json"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_view_chars",
        "target_count",
        "context_overhead_chars"
      ],
      "properties": {
        "model_view_chars": {"type": "integer", "minimum": 1},
        "target_count": {"type": "integer", "minimum": 0},
        "context_overhead_chars": {"type": "integer", "minimum": 0}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_targets",
        "working_targets",
        "lost_targets",
        "duplicated_working_targets",
        "context_only_target_aliases",
        "data_row_overlap",
        "target_order_preserved"
      ],
      "properties": {
        "eligible_targets": {"type": "integer", "minimum": 0},
        "working_targets": {"type": "integer", "minimum": 0},
        "lost_targets": {"const": 0},
        "duplicated_working_targets": {"const": 0},
        "context_only_target_aliases": {"const": 0},
        "data_row_overlap": {"const": 0},
        "target_order_preserved": {"const": true}
      }
    }
  }
}
