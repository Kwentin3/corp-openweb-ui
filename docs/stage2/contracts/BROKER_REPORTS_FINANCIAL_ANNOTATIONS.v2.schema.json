{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kwentin3.invalid/schemas/broker-reports/financial-annotations-v2.schema.json",
  "title": "Broker Reports FinancialAnnotationsV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_binding",
    "dictionary_identity",
    "role_pack_identity",
    "instruction_identity",
    "role_instruction_identity",
    "model_identity",
    "annotations",
    "validation_status"
  ],
  "properties": {
    "schema_version": {
      "const": "broker_reports_financial_annotations_v2"
    },
    "canonical_binding": {
      "$ref": "#/$defs/canonicalBinding"
    },
    "dictionary_identity": {
      "$ref": "#/$defs/dictionaryIdentity"
    },
    "role_pack_identity": {
      "$ref": "#/$defs/rolePackIdentity"
    },
    "instruction_identity": {
      "$ref": "#/$defs/instructionIdentity"
    },
    "role_instruction_identity": {
      "$ref": "#/$defs/instructionIdentity"
    },
    "model_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1}
      }
    },
    "annotations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/annotation"
      }
    },
    "validation_status": {
      "const": "validated"
    }
  },
  "$defs": {
    "canonicalBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "canonical_version_id"],
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "canonical_version_id": {"type": "string", "minLength": 1}
      }
    },
    "dictionaryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dictionary_id", "semantic_version"],
      "properties": {
        "dictionary_id": {"type": "string", "minLength": 1},
        "semantic_version": {"type": "string", "minLength": 1}
      }
    },
    "rolePackIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_pack_id", "semantic_version"],
      "properties": {
        "role_pack_id": {"type": "string", "minLength": 1},
        "semantic_version": {"type": "string", "minLength": 1}
      }
    },
    "instructionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction_id", "semantic_version"],
      "properties": {
        "instruction_id": {"type": "string", "minLength": 1},
        "semantic_version": {"type": "string", "minLength": 1}
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "financial_label", "roles"],
      "properties": {
        "target": {
          "$ref": "https://kwentin3.invalid/schemas/broker-reports/gate3-target-v1.schema.json"
        },
        "financial_label": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/roleBinding"
          }
        }
      }
    },
    "roleBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "status"],
      "properties": {
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "status": {
          "enum": ["bound", "missing"]
        },
        "target": {
          "$ref": "https://kwentin3.invalid/schemas/broker-reports/gate3-target-v1.schema.json"
        },
        "exact_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    }
  }
}
