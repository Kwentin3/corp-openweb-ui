{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kwentin3.github.io/corp-openweb-ui/schemas/broker_reports_managed_document_coverage_receipt_v1.schema.json",
  "title": "Broker Reports Managed Document Coverage Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "source_checksum_sha256",
    "accepted",
    "managed_document_integrity_sha256",
    "entries",
    "counters",
    "integrity_sha256"
  ],
  "properties": {
    "schema_version": {"const": "broker_reports_managed_document_coverage_receipt_v1"},
    "document_id": {"$ref": "#/$defs/id"},
    "source_checksum_sha256": {"$ref": "#/$defs/sha256"},
    "accepted": {"type": "boolean"},
    "managed_document_integrity_sha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    },
    "counters": {"$ref": "#/$defs/counters"},
    "integrity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "idArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "coverage_status",
        "block_ids",
        "anchor_ids",
        "loss_ids",
        "reason_code"
      ],
      "properties": {
        "observation_id": {"$ref": "#/$defs/id"},
        "coverage_status": {
          "enum": [
            "REPRESENTED_BY_BLOCK",
            "REPRESENTED_BY_ANCHOR",
            "REPRESENTED_BY_TABLE",
            "DUPLICATE_SUPPRESSED",
            "KNOWN_LOSS",
            "BLOCKED_AT_SOURCE",
            "UNRESOLVED"
          ]
        },
        "block_ids": {"$ref": "#/$defs/idArray"},
        "anchor_ids": {"$ref": "#/$defs/idArray"},
        "loss_ids": {"$ref": "#/$defs/idArray"},
        "duplicate_of_observation_id": {"$ref": "#/$defs/id"},
        "reason_code": {"$ref": "#/$defs/id"}
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_observations_total",
        "coverage_entries_total",
        "unresolved_total",
        "known_loss_total",
        "blocked_at_source_total",
        "unaccounted_context_loss_total",
        "invented_source_content_total"
      ],
      "properties": {
        "source_observations_total": {"type": "integer", "minimum": 1},
        "coverage_entries_total": {"type": "integer", "minimum": 1},
        "unresolved_total": {"type": "integer", "minimum": 0},
        "known_loss_total": {"type": "integer", "minimum": 0},
        "blocked_at_source_total": {"type": "integer", "minimum": 0},
        "unaccounted_context_loss_total": {"const": 0},
        "invented_source_content_total": {"const": 0}
      }
    }
  }
}
