{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kwentin3.example/contracts/broker_reports_doc4_adjudication_v1.schema.json",
  "title": "Broker Reports DOC4 source adjudication v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "broker_reports_doc4_adjudication_v1"},
    "safe_id": {"enum": ["real_pdf_1", "real_pdf_2", "real_pdf_4", "real_pdf_5"]},
    "gold_checklist_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pdf_response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "view_response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "comparison_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "complete": {"const": true},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "metrics": {"$ref": "#/$defs/metrics"},
    "model_task_adequacy": {"enum": ["PASSED", "FAILED"]},
    "document_semantic_assessment": {"enum": ["DOCUMENT_PASSED_STRICT", "DOCUMENT_PASSED_WITH_NONCRITICAL_VARIANCE", "DOCUMENT_FAILED", "DOCUMENT_INCONCLUSIVE_MODEL_INADEQUACY"]},
    "integrity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": ["schema_version", "safe_id", "gold_checklist_sha256", "pdf_response_sha256", "view_response_sha256", "comparison_sha256", "complete", "findings", "metrics", "model_task_adequacy", "document_semantic_assessment", "integrity_sha256"],
  "$defs": {
    "nullable_string": {"type": ["string", "null"]},
    "rate": {"type": "string", "pattern": "^(?:0\\.\\d{6}|1\\.000000)$"},
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finding_id": {"type": "string"},
        "semantic_key": {"type": "string"},
        "gold_item_id": {"$ref": "#/$defs/nullable_string"},
        "critical": {"type": "boolean"},
        "comparison_category": {"enum": ["MATCH_EXACT", "MATCH_NORMALIZED", "PDF_ONLY_FACT", "VIEW_ONLY_FACT", "VALUE_CONFLICT", "STATUS_CONFLICT", "ORDER_CONFLICT", "MISSING_POINTER", "INVALID_POINTER", "UNSUPPORTED_FACT", "UNCOMPARABLE"]},
        "disposition": {"enum": ["PDF_ARM_CORRECT", "VIEW_ARM_CORRECT", "BOTH_CORRECT", "PDF_ARM_WRONG", "VIEW_ARM_WRONG", "BOTH_WRONG", "ARTIFACT_SEMANTIC_GAP", "PDF_NATIVE_MODEL_GAP", "MODEL_GENERAL_FAILURE", "PROMPT_OR_SCHEMA_FAILURE", "SOURCE_AMBIGUOUS"]},
        "pdf_arm_correct": {"type": "boolean"},
        "view_arm_correct": {"type": "boolean"},
        "pdf_arm_unsupported": {"type": "boolean"},
        "view_arm_unsupported": {"type": "boolean"},
        "pdf_pointer_valid": {"type": ["boolean", "null"]},
        "view_pointer_valid": {"type": ["boolean", "null"]},
        "artifact_semantic_gap": {"type": "boolean"},
        "pdf_native_model_gap": {"type": "boolean"},
        "both_wrong": {"type": "boolean"},
        "unsupported_fact": {"type": "boolean"},
        "invalid_pointer": {"type": "boolean"},
        "notes": {"$ref": "#/$defs/nullable_string"}
      },
      "required": ["finding_id", "semantic_key", "gold_item_id", "critical", "comparison_category", "disposition", "pdf_arm_correct", "view_arm_correct", "pdf_arm_unsupported", "view_arm_unsupported", "pdf_pointer_valid", "view_pointer_valid", "artifact_semantic_gap", "pdf_native_model_gap", "both_wrong", "unsupported_fact", "invalid_pointer", "notes"]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gold_critical_facts_total": {"type": "integer", "minimum": 0},
        "gold_noncritical_facts_total": {"type": "integer", "minimum": 0},
        "pdf_correct_critical_facts_total": {"type": "integer", "minimum": 0},
        "pdf_missing_critical_facts_total": {"type": "integer", "minimum": 0},
        "pdf_unsupported_critical_facts_total": {"type": "integer", "minimum": 0},
        "view_correct_critical_facts_total": {"type": "integer", "minimum": 0},
        "view_missing_critical_facts_total": {"type": "integer", "minimum": 0},
        "view_unsupported_critical_facts_total": {"type": "integer", "minimum": 0},
        "pdf_wrong_critical_facts_total": {"type": "integer", "minimum": 0},
        "view_wrong_critical_facts_total": {"type": "integer", "minimum": 0},
        "pdf_correct_noncritical_facts_total": {"type": "integer", "minimum": 0},
        "pdf_missing_noncritical_facts_total": {"type": "integer", "minimum": 0},
        "pdf_wrong_noncritical_facts_total": {"type": "integer", "minimum": 0},
        "pdf_unsupported_noncritical_facts_total": {"type": "integer", "minimum": 0},
        "view_correct_noncritical_facts_total": {"type": "integer", "minimum": 0},
        "view_missing_noncritical_facts_total": {"type": "integer", "minimum": 0},
        "view_wrong_noncritical_facts_total": {"type": "integer", "minimum": 0},
        "view_unsupported_noncritical_facts_total": {"type": "integer", "minimum": 0},
        "pdf_critical_precision": {"$ref": "#/$defs/rate"},
        "pdf_critical_recall": {"$ref": "#/$defs/rate"},
        "pdf_noncritical_precision": {"$ref": "#/$defs/rate"},
        "pdf_noncritical_recall": {"$ref": "#/$defs/rate"},
        "view_critical_precision": {"$ref": "#/$defs/rate"},
        "view_critical_recall": {"$ref": "#/$defs/rate"},
        "view_noncritical_precision": {"$ref": "#/$defs/rate"},
        "view_noncritical_recall": {"$ref": "#/$defs/rate"},
        "pdf_numeric_exact_match_total": {"type": "integer", "minimum": 0},
        "view_numeric_exact_match_total": {"type": "integer", "minimum": 0},
        "pdf_date_exact_match_total": {"type": "integer", "minimum": 0},
        "view_date_exact_match_total": {"type": "integer", "minimum": 0},
        "pdf_currency_exact_match_total": {"type": "integer", "minimum": 0},
        "view_currency_exact_match_total": {"type": "integer", "minimum": 0},
        "pdf_pointer_valid_total": {"type": "integer", "minimum": 0},
        "pdf_pointer_invalid_total": {"type": "integer", "minimum": 0},
        "pdf_critical_pointer_invalid_total": {"type": "integer", "minimum": 0},
        "view_pointer_valid_total": {"type": "integer", "minimum": 0},
        "view_pointer_invalid_total": {"type": "integer", "minimum": 0},
        "view_critical_pointer_invalid_total": {"type": "integer", "minimum": 0},
        "pdf_structure_order_match": {"type": "boolean"},
        "view_structure_order_match": {"type": "boolean"},
        "unsupported_facts_total": {"type": "integer", "minimum": 0},
        "unsupported_critical_facts_total": {"type": "integer", "minimum": 0},
        "artifact_semantic_gaps_total": {"type": "integer", "minimum": 0},
        "pdf_native_model_gaps_total": {"type": "integer", "minimum": 0},
        "both_arms_wrong_total": {"type": "integer", "minimum": 0},
        "invalid_source_pointers_total": {"type": "integer", "minimum": 0},
        "critical_stability_conflicts_total": {"type": "integer", "minimum": 0},
        "critical_cross_arm_correct_matches_total": {"type": "integer", "minimum": 0},
        "critical_cross_arm_correct_match_rate": {"$ref": "#/$defs/rate"},
        "noncritical_cross_arm_correct_matches_total": {"type": "integer", "minimum": 0},
        "noncritical_cross_arm_correct_match_rate": {"$ref": "#/$defs/rate"}
      },
      "required": ["gold_critical_facts_total", "gold_noncritical_facts_total", "pdf_correct_critical_facts_total", "pdf_missing_critical_facts_total", "pdf_wrong_critical_facts_total", "pdf_unsupported_critical_facts_total", "view_correct_critical_facts_total", "view_missing_critical_facts_total", "view_wrong_critical_facts_total", "view_unsupported_critical_facts_total", "pdf_correct_noncritical_facts_total", "pdf_missing_noncritical_facts_total", "pdf_wrong_noncritical_facts_total", "pdf_unsupported_noncritical_facts_total", "view_correct_noncritical_facts_total", "view_missing_noncritical_facts_total", "view_wrong_noncritical_facts_total", "view_unsupported_noncritical_facts_total", "pdf_critical_precision", "pdf_critical_recall", "pdf_noncritical_precision", "pdf_noncritical_recall", "view_critical_precision", "view_critical_recall", "view_noncritical_precision", "view_noncritical_recall", "pdf_numeric_exact_match_total", "view_numeric_exact_match_total", "pdf_date_exact_match_total", "view_date_exact_match_total", "pdf_currency_exact_match_total", "view_currency_exact_match_total", "pdf_pointer_valid_total", "pdf_pointer_invalid_total", "pdf_critical_pointer_invalid_total", "view_pointer_valid_total", "view_pointer_invalid_total", "view_critical_pointer_invalid_total", "pdf_structure_order_match", "view_structure_order_match", "unsupported_facts_total", "unsupported_critical_facts_total", "artifact_semantic_gaps_total", "pdf_native_model_gaps_total", "both_arms_wrong_total", "invalid_source_pointers_total", "critical_stability_conflicts_total", "critical_cross_arm_correct_matches_total", "critical_cross_arm_correct_match_rate", "noncritical_cross_arm_correct_matches_total", "noncritical_cross_arm_correct_match_rate"]
    }
  }
}
