{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kwentin3.invalid/schemas/broker-reports/gate3-predeclared-assertion-labeling-response-v1.schema.json",
  "title": "Broker Reports Gate 3 Predeclared Assertion Labeling Response V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "classifications"],
  "properties": {
    "schema_version": {
      "const": "broker_reports_gate3_predeclared_assertion_labeling_response_v1"
    },
    "classifications": {
      "type": "array",
      "items": {"$ref": "#/$defs/classification"}
    }
  },
  "$defs": {
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "financial_types"],
      "properties": {
        "assertion_id": {
          "type": "string",
          "pattern": "^t[0-9]{3,}$",
          "description": "Exact predeclared backend alias; return bare tNNN only."
        },
        "financial_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/financialType"},
          "description": "Existing dictionary labels, or the single value UNMAPPED."
        }
      }
    },
    "financialType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    }
  }
}
