{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://broker-reports.invalid/contracts/BROKER_REPORTS_TABLE_RECOVERY_PROOF.v1.schema.json",
  "title": "Broker Reports Table Recovery Proof v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "base_commit",
    "implementation_commit",
    "implementation_merge_commit",
    "evidence_merge_commit",
    "expected_logical_tables_total",
    "baseline_validated_tables_total",
    "baseline_without_validated_grid_total",
    "failed_tables_classified_total",
    "unclassified_failed_tables_total",
    "validated_table_fragments_after_total",
    "validated_tables_after_total",
    "validated_multi_page_tables_total",
    "explicit_noncritical_unknown_tables_total",
    "blocked_unrecoverable_critical_tables_total",
    "critical_financial_tables_total",
    "critical_financial_tables_without_validated_grid_total",
    "baseline_tables_regressed_total",
    "table_rows_gold_total",
    "table_rows_matched_total",
    "table_cells_gold_total",
    "table_cells_matched_total",
    "critical_table_mismatches_total",
    "invented_table_values_total",
    "silently_dropped_table_values_total",
    "unresolved_table_words_total",
    "multiple_cell_word_owners_total",
    "table_words_duplicated_as_paragraph_total",
    "pdf_vs_view_table_semantic_parity",
    "doc1_schema_changed",
    "provider_calls_total",
    "product_activation_started",
    "production_model_qualification_started",
    "generated_bundle_diff",
    "live_changes_total",
    "new_skips_total",
    "test_failures_total",
    "test_errors_total",
    "status",
    "integrity_sha256"
  ],
  "properties": {
    "schema_version": {"const": "broker_reports_doc5_geometry_table_recovery_receipt_v1"},
    "base_commit": {"$ref": "#/$defs/commitOrReceiptMarker"},
    "implementation_commit": {"$ref": "#/$defs/commitOrReceiptMarker"},
    "implementation_merge_commit": {"$ref": "#/$defs/commitOrReceiptMarker"},
    "evidence_merge_commit": {"$ref": "#/$defs/commitOrReceiptMarker"},
    "expected_logical_tables_total": {"type": "integer", "minimum": 0},
    "baseline_validated_tables_total": {"type": "integer", "minimum": 0},
    "baseline_without_validated_grid_total": {"type": "integer", "minimum": 0},
    "failed_tables_classified_total": {"type": "integer", "minimum": 0},
    "unclassified_failed_tables_total": {"type": "integer", "minimum": 0},
    "validated_table_fragments_after_total": {"$ref": "#/$defs/nullableCounter"},
    "validated_tables_after_total": {"$ref": "#/$defs/nullableCounter"},
    "validated_multi_page_tables_total": {"$ref": "#/$defs/nullableCounter"},
    "explicit_noncritical_unknown_tables_total": {"$ref": "#/$defs/nullableCounter"},
    "blocked_unrecoverable_critical_tables_total": {"type": "integer", "minimum": 0},
    "critical_financial_tables_total": {"type": "integer", "minimum": 0},
    "critical_financial_tables_without_validated_grid_total": {"type": "integer", "minimum": 0},
    "baseline_tables_regressed_total": {"type": "integer", "minimum": 0},
    "table_rows_gold_total": {"$ref": "#/$defs/nullableCounter"},
    "table_rows_matched_total": {"$ref": "#/$defs/nullableCounter"},
    "table_cells_gold_total": {"$ref": "#/$defs/nullableCounter"},
    "table_cells_matched_total": {"$ref": "#/$defs/nullableCounter"},
    "critical_table_mismatches_total": {"$ref": "#/$defs/nullableCounter"},
    "invented_table_values_total": {"$ref": "#/$defs/nullableCounter"},
    "silently_dropped_table_values_total": {"$ref": "#/$defs/nullableCounter"},
    "unresolved_table_words_total": {"$ref": "#/$defs/nullableCounter"},
    "multiple_cell_word_owners_total": {"$ref": "#/$defs/nullableCounter"},
    "table_words_duplicated_as_paragraph_total": {"$ref": "#/$defs/nullableCounter"},
    "pdf_vs_view_table_semantic_parity": {"enum": ["PASSED", "FAILED", "BLOCKED"]},
    "doc1_schema_changed": {"type": "boolean"},
    "provider_calls_total": {"type": "integer", "minimum": 0},
    "product_activation_started": {"type": "boolean"},
    "production_model_qualification_started": {"type": "boolean"},
    "generated_bundle_diff": {"type": "integer", "minimum": 0},
    "live_changes_total": {"type": "integer", "minimum": 0},
    "new_skips_total": {"type": "integer", "minimum": 0},
    "test_failures_total": {"type": "integer", "minimum": 0},
    "test_errors_total": {"type": "integer", "minimum": 0},
    "last_proven_stage": {"type": "string", "minLength": 1, "maxLength": 256},
    "affected_tables": {"type": "array", "items": {"type": "string", "pattern": "^real_pdf_[0-9]+_table_[0-9]{2}$"}, "uniqueItems": true},
    "first_failure_point": {"type": "string", "minLength": 1, "maxLength": 256},
    "available_geometry": {"type": "string", "minLength": 1, "maxLength": 2048},
    "missing_evidence": {"type": "string", "minLength": 1, "maxLength": 2048},
    "why_logical_grid_cannot_be_proven": {"type": "string", "minLength": 1, "maxLength": 4096},
    "minimal_required_contract_change": {"type": "string", "minLength": 1, "maxLength": 4096},
    "next_operator_action": {"type": "string", "minLength": 1, "maxLength": 2048},
    "status": {"enum": ["PASSED", "BLOCKED"]},
    "integrity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "nullableCounter": {"type": ["integer", "null"], "minimum": 0},
    "commitOrReceiptMarker": {
      "type": "string",
      "minLength": 7,
      "maxLength": 96,
      "pattern": "^(?:[0-9a-f]{7,40}|reported_[a-z0-9_]+)$"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASSED"}}},
      "then": {
        "properties": {
          "expected_logical_tables_total": {"const": 28},
          "baseline_validated_tables_total": {"const": 6},
          "baseline_without_validated_grid_total": {"const": 22},
          "failed_tables_classified_total": {"const": 22},
          "unclassified_failed_tables_total": {"const": 0},
          "validated_table_fragments_after_total": {"type": "integer", "minimum": 0},
          "validated_tables_after_total": {"type": "integer", "minimum": 0},
          "validated_multi_page_tables_total": {"type": "integer", "minimum": 0},
          "explicit_noncritical_unknown_tables_total": {"type": "integer", "minimum": 0},
          "blocked_unrecoverable_critical_tables_total": {"const": 0},
          "critical_financial_tables_total": {"const": 28},
          "critical_financial_tables_without_validated_grid_total": {"const": 0},
          "baseline_tables_regressed_total": {"const": 0},
          "table_rows_gold_total": {"type": "integer", "minimum": 0},
          "table_rows_matched_total": {"type": "integer", "minimum": 0},
          "table_cells_gold_total": {"type": "integer", "minimum": 0},
          "table_cells_matched_total": {"type": "integer", "minimum": 0},
          "critical_table_mismatches_total": {"const": 0},
          "invented_table_values_total": {"const": 0},
          "silently_dropped_table_values_total": {"const": 0},
          "unresolved_table_words_total": {"const": 0},
          "multiple_cell_word_owners_total": {"const": 0},
          "table_words_duplicated_as_paragraph_total": {"const": 0},
          "pdf_vs_view_table_semantic_parity": {"const": "PASSED"},
          "doc1_schema_changed": {"const": false},
          "provider_calls_total": {"const": 0},
          "product_activation_started": {"const": false},
          "production_model_qualification_started": {"const": false},
          "generated_bundle_diff": {"const": 0},
          "live_changes_total": {"const": 0},
          "new_skips_total": {"const": 0},
          "test_failures_total": {"const": 0},
          "test_errors_total": {"const": 0}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "BLOCKED"}}},
      "then": {
        "required": [
          "last_proven_stage",
          "affected_tables",
          "first_failure_point",
          "available_geometry",
          "missing_evidence",
          "why_logical_grid_cannot_be_proven",
          "minimal_required_contract_change",
          "next_operator_action"
        ],
        "properties": {
          "affected_tables": {"type": "array", "minItems": 1},
          "pdf_vs_view_table_semantic_parity": {"enum": ["FAILED", "BLOCKED"]}
        }
      }
    }
  ]
}
