{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kwentin3.invalid/schemas/broker-reports/gate3-financial-role-pack-v1.schema.json",
  "title": "Broker Reports Gate 3 Financial Role Pack V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role_pack_id",
    "semantic_version",
    "status",
    "published_at",
    "approval",
    "binding_contract",
    "roles",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "const": "broker_reports_gate3_financial_role_pack_v1"
    },
    "role_pack_id": {
      "type": "string",
      "minLength": 1
    },
    "semantic_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "PUBLISHED"
    },
    "published_at": {
      "type": "string",
      "minLength": 1
    },
    "approval": {
      "$ref": "#/$defs/approval"
    },
    "binding_contract": {
      "$ref": "#/$defs/bindingContract"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/role"
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "decision",
        "approved_by_role",
        "approved_at",
        "basis"
      ],
      "properties": {
        "approval_id": {"type": "string", "minLength": 1},
        "decision": {"const": "APPROVED"},
        "approved_by_role": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "minLength": 1},
        "basis": {"type": "string", "minLength": 1}
      }
    },
    "bindingContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_source",
        "exact_text_policy",
        "normalized_or_computed_values_allowed",
        "maximum_bindings_per_role_per_fact",
        "missing_status"
      ],
      "properties": {
        "value_source": {"const": "canonical_target_text"},
        "exact_text_policy": {
          "const": "optional_nonempty_literal_substring"
        },
        "normalized_or_computed_values_allowed": {"const": false},
        "maximum_bindings_per_role_per_fact": {"const": 1},
        "missing_status": {"const": "missing"}
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_id", "meaning", "value_kind"],
      "properties": {
        "role_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "meaning": {"type": "string", "minLength": 1},
        "value_kind": {"type": "string", "minLength": 1}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "financial_label",
        "required_roles",
        "optional_roles"
      ],
      "properties": {
        "financial_label": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "required_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          }
        },
        "optional_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          }
        }
      }
    }
  }
}
