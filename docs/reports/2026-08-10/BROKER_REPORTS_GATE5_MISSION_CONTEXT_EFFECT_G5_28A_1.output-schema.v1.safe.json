{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domains"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "broker_reports_declaration_obligation_grouping_candidate_v0"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain_id", "semantic_meaning", "obligation_refs", "expected_component"],
        "properties": {
          "domain_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "semantic_meaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 640
          },
          "obligation_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^obl_[a-z0-9_]+$"
            }
          },
          "expected_component": {
            "type": "object",
            "additionalProperties": false,
            "required": ["family", "availability", "contract_ids"],
            "properties": {
              "family": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,95}$"
              },
              "availability": {
                "type": "string",
                "enum": ["missing", "published_bounded", "published_exact"]
              },
              "contract_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
