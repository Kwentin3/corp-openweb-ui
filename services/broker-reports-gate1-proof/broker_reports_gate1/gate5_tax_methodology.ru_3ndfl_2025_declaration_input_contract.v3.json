        "organized-market-classification-article-214.1-v1",
        "foreign-currency-conversion-article-210-v1",
        "partial-acquisition-commission-v1"
      ],
      "external_methodology_refs": [
        "ru-ndfl-securities-source-fact-consumption-proof@2026.7-current-authority",
        "ru-ndfl-securities-tax-model-proof@2026.2-audited"
      ]
    },
    {
      "demand": "obl_income_group_tax_base_results",
      "owner": "Gate5IncomeGroupTaxBaseRuntimeFactory.create",
      "rule_ids": [
        "coupon-securities-income-article-214.1-v1",
        "dividend-income-group-articles-210-214-v1",
        "organized-market-classification-article-214.1-v1",
        "foreign-currency-conversion-article-210-v1"
      ],
      "external_methodology_refs": [
        "ru-ndfl-securities-tax-model-proof@2026.3-audited"
      ]
    },
    {
      "demand": "obl_income_group_tax_settlement_results",
      "owner": "Gate5DeclarationTaxSettlementRuntimeFactory.create",
      "rule_ids": ["foreign-tax-credit-articles-214-232-v3"],
      "external_methodology_refs": [
        "ru-3ndfl-2025-income-group-settlement-proof@2026.4-audited"
      ]
    }
  ],
