    {"role_id": "currency", "meaning": "Money currency directly stated for the source fact target.", "value_kind": "source_currency_text"},
    {"role_id": "source_wording", "meaning": "Literal source wording directly expressing the fact meaning in the same source target.", "value_kind": "source_literal_text"},
    {"role_id": "position_effect", "meaning": "Exact source-authored position effect; OPEN_SHORT is admissible only when that literal is bound to the same disposal target.", "value_kind": "source_position_effect_code"}
  ],
  "profiles": [
